<Window x:Class="Pogoreco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pogoreco" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,20">
            <StackPanel>
                <TextBlock Text="pogoreco" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" />
                <TextBlock x:Name="Subtitle" Text="Pogostuck の記録帳" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,16" />
                <StackPanel x:Name="Nav" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,48" MaxWidth="1200">
                <StackPanel x:Name="StatusArea" />
                <ContentControl x:Name="PageHost" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
