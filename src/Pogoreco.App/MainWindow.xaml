<Window x:Class="Pogoreco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pogoreco" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左のメニュー: 地と同じ色。上にロゴ（山と旗）と名前 -->
        <Border Grid.Column="0" Padding="14,26,6,20">
            <DockPanel LastChildFill="True">
            <!-- 記録中かどうかの表示（メニューの下） -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                <StackPanel x:Name="SideActions" Orientation="Horizontal" Margin="0,0,0,10" />
                <Border x:Name="RecordingStatus" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                    <Viewbox Width="38" Height="38">
                        <Canvas Width="38" Height="38">
                            <Ellipse Width="38" Height="38" Fill="#DAEFE3" />
                            <Path Data="M5,29 L15,13 L21,22 L25,17 L33,29 Z" Fill="#9FD0B7" />
                            <Rectangle Canvas.Left="17" Canvas.Top="5" Width="2.5" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="#E8788F" />
                            <Path Data="M19.5,5 L26,7.5 L19.5,10 Z" Fill="#E8788F" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitle" Text="pogoreco" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="Subtitle" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="Nav" />
            </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,24,28,48" MaxWidth="1200">
                <StackPanel x:Name="TopBar" />
                <StackPanel x:Name="StatusArea" />
                <ContentControl x:Name="PageHost" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
