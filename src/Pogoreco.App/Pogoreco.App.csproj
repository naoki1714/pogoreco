<Project Sdk="Microsoft.NET.Sdk">
  <!-- 記録を見る画面（WPF）。見るときだけ開く -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pogoreco</AssemblyName>
    <StartupObject>Pogoreco.App.Program</StartupObject>
    <RootNamespace>Pogoreco.App</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pogoreco.Platform\Pogoreco.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
